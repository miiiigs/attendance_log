{
  "expo": {
    "name": "Activity Log",
    "slug": "attendance-logger-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/scppa-logo.png",
    "scheme": "attendance",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Attendance Logger uses the camera to scan time in and time out QR codes."
      }
    },
    "android": {
      "package": "com.scppa.portal",
      "adaptiveIcon": {
        "backgroundColor": "#F8F7F4",
        "foregroundImage": "./assets/images/scppa-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/scppa-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/scppa-logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F8F7F4",
          "dark": {
            "image": "./assets/images/scppa-logo.png",
            "backgroundColor": "#F8F7F4"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "06f8696c-9388-43b3-b51c-54beef6a2b9d"
      }
    }
  }
}
